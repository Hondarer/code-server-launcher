# 初回 install 時に実ファイルが生成される。本ファイルはひな型であり、起動には使用しない。
# Linux:    ~/.config/code-server-launcher/config.yaml
# Windows:  %USERPROFILE%\.config\code-server-launcher\config.yaml
#
# password は install スクリプトが生成する。実ファイルはリポジトリ内に配置しない。

bind-addr: 0.0.0.0:8000
auth: password
password: replace-with-generated-password
cert: false
disable-telemetry: true
disable-update-check: true
